<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="@color/warm_cream"
            android:contentDescription="Materi Icon"
            android:padding="12dp"
            app:srcCompat="@drawable/user_2"
            app:tint="@color/burgundy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMateriTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cara Menggunakan APAR yang Benar"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMateriDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Video tutorial penggunaan APAR dalam situasi kebakaran."
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMateriCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/warm_cream"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Video"
                android:textColor="@color/burgundy"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Arrow"
            app:srcCompat="@drawable/ic_launcher_foreground"
            app:tint="#888888" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
